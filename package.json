{
  "name": "highfivegames",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prototype:walk": "vite --open /prototype-walk-feel.html",
    "prototype:guard": "vite --open /prototype-guard.html",
    "prototype:sling": "vite --open /prototype-sling.html",
    "prototype:ammo": "vite --open /prototype-ammo.html",
    "prototype:kill": "vite --open /prototype-kill.html",
    "prototype:pa": "vite --open /prototype-pa.html",
    "pa:setup": "node scripts/setup-pa-tools.mjs",
    "pa:render": "node scripts/render-pa.mjs",
    "pa:audition": "node scripts/render-pa.mjs --audition",
    "test:upgrades": "node --test src/upgrades.test.mjs",
    "test:upgrades:browser": "node --test scripts/test-upgrade-playtest.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "playcanvas": "^2.22.2"
  },
  "devDependencies": {
    "playwright": "^1.63.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": ">=22.23.2"
  }
}
